# Secrets / Credentials - CRITICAL
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.p12
*.key
id_rsa*
*.crt
service_account*.json
credentials*.json
*_credentials.json
secrets.yaml
secrets.json
.netrc
.npmrc
.pypirc

# =============================================================================
# API Keys / Tokens (patterns)
# =============================================================================
**/api_key*
**/apikey*
**/*token*
!**/token.py
!**/tokens.py

